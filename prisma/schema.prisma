generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Manga {
  id          String   @id @default(uuid())
  title       String
  description String?
  cover       String?
  status      String   @default("unknown")
  type        String   @default("manga")
  year        Int?
  contentRating String @default("safe")
  originalLanguage String @default("ja")
  
  // Storing simple string arrays for genres and tags for simplicity
  genres      String[]
  language    String[] // e.g. ["pt-BR"]

  // Authors & Artists could be relations, but for MVP keeping as string arrays
  authors     String[]
  artists     String[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  titles      MangaTitle[]
  providers   MangaProvider[]
  chapters    Chapter[]
}

model MangaTitle {
  id        String   @id @default(uuid())
  mangaId   String
  manga     Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  title     String
  isPrimary Boolean  @default(false)
  
  @@index([title])
}

model MangaProvider {
  id         String   @id @default(uuid())
  mangaId    String
  manga      Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  providerId String   // "mangadex", "consumet"
  externalId String   // The ID on the remote provider
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([providerId, externalId])
  @@index([mangaId])
}

model Chapter {
  id          String   @id @default(uuid())
  mangaId     String
  manga       Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  number      String
  volume      String?
  title       String?
  language    String
  publishedAt DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  providers   ChapterProvider[]

  // Deduplication check index
  @@index([mangaId, number, language])
}

model ChapterProvider {
  id         String   @id @default(uuid())
  chapterId  String
  chapter    Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  providerId String   // "mangadex"
  externalId String   // remote chapter id
  
  @@unique([providerId, externalId])
}
